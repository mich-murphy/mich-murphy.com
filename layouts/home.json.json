{{- /* The search index home's script loads: every post, newest first, as {s, t, d, g, l}: slug, title, date, tags (as
  tag-slug.html gives them) and sections. A section is [anchor, kinds, text, …]: the id of the h2 or h3 it starts with
  ("" above the first), a digit per line for its kind, then the lines (content-lines.html). Grouping by section saves
  repeating the anchor on every line */}}
{{- $posts := slice }}
{{- range (partialCached "posts.html" .).ByDate.Reverse }}
  {{- $sections := slice }}
  {{- /* no id is a NUL, so it starts the first section and closes the last */}}
  {{- $anchor := "\x00" }}
  {{- $kinds := "" }}
  {{- $texts := slice }}
  {{- range (partialCached "content-lines.html" . .Path) | append (dict "anchor" "\x00") }}
    {{- if ne .anchor $anchor }}
      {{- with $texts }}
        {{- /* append spreads a slice of strings into a slice, so the first section starts the list of them */}}
        {{- $section := slice $anchor $kinds | append . }}
        {{- if $sections }}{{ $sections = $sections | append $section }}{{ else }}{{ $sections = slice $section }}{{ end }}
      {{- end }}
      {{- $anchor = .anchor }}
      {{- $kinds = "" }}
      {{- $texts = slice }}
    {{- end }}
    {{- if .text }}{{ $kinds = print $kinds .kind }}{{ $texts = $texts | append .text }}{{ end }}
  {{- end }}
  {{- $tags := slice }}
  {{- range .GetTerms "tags" }}{{ $tags = $tags | append (partial "tag-slug.html" .) }}{{ end }}
  {{- $posts = $posts | append (dict "s" .File.ContentBaseName "t" .Title "d" (.Date.Format "2006-01-02") "g" $tags "l" $sections) }}
{{- end }}
{{- $posts | jsonify (dict "noHTMLEscape" true) }}
