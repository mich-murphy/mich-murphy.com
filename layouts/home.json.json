{{- /* The search index that home's script loads: every post, newest first, as {s, t, d, g, l}: its slug, title, date,
  tags (as tag-slug.html gives them) and lines. A line is [text, anchor, kind], with kind 0 for prose, 1 for a
  heading and 2 for code, read from the post's Markdown. Blank lines and fence lines are skipped. Prose is what a
  reader sees: link text without its URL, no **, no list or quote markers, and no line for an alert's [!NOTE]. A
  heading loses its #s, and code stays as written. The anchor is the id of the h2 or h3 the line sits under. The
  Markdown doesn't say what id Hugo gave a heading, so each h2 or h3 line takes the next one from headings.html, in
  document order, and the build fails if the two disagree on how many there are */}}
{{- $posts := slice }}
{{- range (partialCached "posts.html" .).ByDate.Reverse }}
  {{- $source := .File.Path }}
  {{- $headings := partial "headings.html" . }}
  {{- $h := 0 }}
  {{- $anchor := "" }}
  {{- $fence := "" }}
  {{- $rows := slice }}
  {{- range $line := split .RawContent "\n" }}
    {{- $text := strings.TrimSpace $line }}
    {{- $marker := "" }}
    {{- with findRESubmatch "^ {0,3}(`{3,}|~{3,})" $line 1 }}{{ $marker = index . 0 1 }}{{ end }}
    {{- $row := false }}
    {{- if $fence }}
      {{- /* a fence closes with a line of only its character, at least as many times as it opened */}}
      {{- if and $marker (eq (substr $marker 0 1) (substr $fence 0 1)) (ge (len $marker) (len $fence)) (eq $text $marker) }}
        {{- $fence = "" }}
      {{- else if $text }}
        {{- $row = slice (strings.TrimRight " \t\r\n\v\f" $line) $anchor 2 }}
      {{- end }}
    {{- else if $marker }}
      {{- $fence = $marker }}
    {{- else if $text }}
      {{- with findRESubmatch `^ {0,3}(#{1,6})(?:[ \t]+(.*?))?(?:[ \t]+#+)?[ \t]*$` $line 1 }}
        {{- $match := index . 0 }}
        {{- $level := len (index $match 1) }}
        {{- /* headings.html has only h2 and h3, so a line under an h4 keeps the anchor above it */}}
        {{- if and (ge $level 2) (le $level 3) }}
          {{- if ge $h (len $headings) }}{{ errorf "search index: %s has more h2 and h3 lines than Hugo found headings" $source }}{{ end }}
          {{- $anchor = (index $headings $h).id }}
          {{- $h = add $h 1 }}
        {{- end }}
        {{- $row = slice (strings.TrimSpace (index $match 2)) $anchor 1 }}
      {{- else }}
        {{- $prose := replaceRE `^\s*>\s?` "" $line }}
        {{- $prose = replaceRE `^\s*(?:[-*+]|\d+\.)\s+` "" $prose }}
        {{- $prose = replaceRE `!?\[([^\]]*)\]\([^)]*\)` "${1}" $prose }}
        {{- $prose = replaceRE `<(https?://[^>]+)>` "${1}" $prose }}
        {{- $prose = replaceRE `\*\*(.+?)\*\*` "${1}" $prose }}
        {{- $prose = strings.TrimSpace $prose }}
        {{- if and $prose (not (findRE `^\[!\w+\]$` $prose 1)) }}{{ $row = slice $prose $anchor 0 }}{{ end }}
      {{- end }}
    {{- end }}
    {{- /* the first row starts a slice of rows; appended to an empty slice, it would be spread into it */}}
    {{- if $row }}{{ if $rows }}{{ $rows = $rows | append $row }}{{ else }}{{ $rows = slice $row }}{{ end }}{{ end }}
  {{- end }}
  {{- if ne $h (len $headings) }}{{ errorf "search index: Hugo found %d h2 and h3 headings in %s, and its Markdown has %d" (len $headings) $source $h }}{{ end }}
  {{- $tags := slice }}
  {{- range .GetTerms "tags" }}{{ $tags = $tags | append (partial "tag-slug.html" .) }}{{ end }}
  {{- $posts = $posts | append (dict "s" .File.ContentBaseName "t" .Title "d" (.Date.Format "2006-01-02") "g" $tags "l" $rows) }}
{{- end }}
{{- $posts | jsonify (dict "noHTMLEscape" true) }}
